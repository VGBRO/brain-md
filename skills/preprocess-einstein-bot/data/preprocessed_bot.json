    "actions": {
        "generateKnowledgeLogData": {
            "target": "logFeedback::generateKnowledgeLogData",
            "variables_read": [
                "AnswerFeedback",
                "AnswerSelectedResult",
                "_AnswerResults",
                "_AnswerInput"
            ],
            "variables_written": []
        },
        "EmiratesRegisterProfile": {
            "target": "apex::EmiratesRegisterProfile",
            "variables_read": [
                "Profile_Name",
                "Profile_Password",
                "Profile_Username"
            ],
            "variables_written": [
                "Profile_Id"
            ]
        },
        "EmiratesLoginProfile": {
            "target": "apex::EmiratesLoginProfile",
            "variables_read": [
                "Profile_Name",
                "Profile_Password",
                "Profile_Username"
            ],
            "variables_written": [
                "Profile_Id"
            ]
        },
        "EmiratesLogoutProfile": {
            "target": "apex::EmiratesLogoutProfile",
            "variables_read": [
                "Profile_Id"
            ],
            "variables_written": []
        },
        "EmiratesFetchAirports": {
            "target": "apex::EmiratesFetchAirports",
            "variables_read": [],
            "variables_written": [
                ""
            ]
        },
        "EmiratesFetchFlights": {
            "target": "apex::EmiratesFetchFlights",
            "variables_read": [
                "Booking_Source",
                "Booking_Destination"
            ],
            "variables_written": [
                ""
            ]
        },
        "EmiratesCreateBooking": {
            "target": "apex::EmiratesCreateBooking",
            "variables_read": [
                "Booking_Date",
                "Booking_Source",
                "Booking_Destination",
                "Profile_Id",
                "Booking_Flight"
            ],
            "variables_written": [
                "Booking_Id"
            ]
        },
        "EmiratesFetchBookingIds": {
            "target": "apex::EmiratesFetchBookingIds",
            "variables_read": [
                "Profile_Id"
            ],
            "variables_written": [
                ""
            ]
        },
        "EmiratesRescheduleBooking": {
            "target": "apex::EmiratesRescheduleBooking",
            "variables_read": [
                "Booking_Date",
                "Selected_Booking_Id"
            ],
            "variables_written": [
                "Op_Status"
            ]
        },
        "EmiratesCancelBooking": {
            "target": "apex::EmiratesCancelBooking",
            "variables_read": [
                "Selected_Booking_Id"
            ],
            "variables_written": [
                "Op_Status"
            ]
        },
        "EmiratesFetchBaggageStatus": {
            "target": "apex::EmiratesFetchBaggageStatus",
            "variables_read": [
                "Selected_Booking_Id",
                "Profile_Id"
            ],
            "variables_written": [
                "Baggage_Status"
            ]
        },
        "EmiratesFetchFlightStatus": {
            "target": "apex::EmiratesFetchFlightStatus",
            "variables_read": [
                "Flight_Id"
            ],
            "variables_written": [
                "Flight_Tracking_Status"
            ]
        },
        "EmiratesFetchRewards": {
            "target": "apex::EmiratesFetchRewards",
            "variables_read": [
                "Profile_Id"
            ],
            "variables_written": [
                "Rewards"
            ]
        },
        "EmiratesFetchMerchandiseUrl": {
            "target": "apex::EmiratesFetchMerchandiseUrl",
            "variables_read": [
                "Profile_Id",
                "Rewards"
            ],
            "variables_written": [
                "Merchandise_Url"
            ]
        }
    }
